# API keys for Voice Typing. This file lives in Documents\VoiceTyping\.env
# (tray icon -> Open API Keys). Restart the app after editing.
#
# At least one cloud speech-to-text key is required (or run a local Custom STT server — see README).
# If both are set, ElevenLabs is used for dictation by default. Leave unused keys empty.
ELEVENLABS_API_KEY=""  # Recommended: best dictation accuracy; required for Meeting Mode and Phone Mode (speaker-labeled transcripts)
OPENAI_API_KEY=""  # Alternative dictation provider; required for Streaming Dictation (Beta) and for transcript cleaning
CUSTOM_STT_API_KEY=""  # Optional: if your custom STT server requires authentication
LLM_API_KEY=""  # Optional: key for the transcript-cleaning server when llm_base_url points somewhere other than OpenAI
